{
  "name": "bg-remover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, open-source, fully client-side background remover.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/bg-remover"
  },
  "scripts": {
